{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }],
  "functions": { "api/mcp.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp?op=resource" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/mcp?op=resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp?op=auth-server" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/mcp?op=auth-server" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/mcp?op=auth-server" },
    { "source": "/.well-known/openid-configuration/:path*", "destination": "/api/mcp?op=auth-server" }
  ]
}
